{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundboard",
  "version": "0.1.0",
  "identifier": "dev.soundboard.Soundboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soundboard",
        "width": 1100,
        "height": 720,
        "minWidth": 520,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Soundboard with global hotkeys and Stream Deck support",
    "linux": {
      "deb": { "files": { "/usr/lib/udev/rules.d/70-streamdeck.rules": "../linux/70-streamdeck.rules" } },
      "rpm": { "files": { "/usr/lib/udev/rules.d/70-streamdeck.rules": "../linux/70-streamdeck.rules" } }
    }
  }
}
